# ==========================================================
# TuneDrop: MAMP (Apache + FastCGI PHP) 用の補正
# ==========================================================
# MAMPのApacheはPHPをFastCGI (php_sapi_name = cgi-fcgi) で実行するため、
# ブラウザが送った Authorization ヘッダが $_SERVER に現れない。
# その結果 api.php が JWT を読めず、ログイン中でもゲスト扱いになってしまう。
# ここで Authorization ヘッダを環境変数 HTTP_AUTHORIZATION にコピーして
# api.php (current_user_id / 認証プロキシ) から参照できるようにする。
#
# 前提: mod_setenvif が有効 (MAMPの既定 httpd.conf で LoadModule 済み) かつ
#       DocumentRoot の Directory に AllowOverride All が設定されていること。
# PHPビルトインサーバー (./start.sh) と Live Server は .htaccess を無視するが、
# そちらは元から Authorization ヘッダを正常に受け取れるため影響はない。
<IfModule setenvif_module>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Only the application entry points and known browser assets are public.
Options -Indexes -MultiViews
DirectoryIndex index.html
# mod_authz_core is standard in Apache 2.4; mod_rewrite is not required.
# Support both the project DocumentRoot and MAMP's /Tunedrop/ layout,
# plus the public alias /tunedrop/.
# 末尾スラッシュなし (/tunedrop) も許可し、mod_dir に /tunedrop/ へ
# リダイレクトさせる (許可しないと 403 になり「開けない」原因になる)。
# 管理画面は admin/ にまとめた。開くのは admin/admin.php (admin.sh が URL を作る)。
# ディレクトリ (/admin/) は -Indexes のため 403 になる (ファイルを直接開く)。
# 画面の本体 (index.html) と資産 (assets/*.js, *.css ...) は Vite のビルド成果物。
# 資産はファイル名に内容のハッシュが入るため個別登録できないので、assets/ 直下で
# 拡張子が既知のものだけを許可する (ビルド元の frontend/app.js・frontend/style.css や
# サブフォルダ、隠しファイルは403のまま)。frontend/ で配信し続けるのは
# OGPカード画像 (favicon-card.png。og:image に絶対URLで書くため、ハッシュ付きの
# assets/ には置けない) だけ。
Require expr "%{REQUEST_URI} =~ m#^/(?:[Tt]unedrop/?)?(?:index\.html|api\.php|ogp\.php|robots\.txt|sitemap\.xml|google[a-z0-9]+\.html|admin/admin\.(?:php|js|css)|assets/[A-Za-z0-9_-]+\.(?:js|css|svg|png|jpe?g|webp|gif|ico|woff2?|map)|frontend/favicon-card\.png)?$#"

# ==========================================================
# TuneDrop: 配信の軽量化 (gzip + ブラウザ資産のキャッシュ)
# ==========================================================
# MAMP既定の httpd.conf は LoadModule deflate_module がコメントアウトされている。
# 圧縮を効かせたい場合は httpd.conf の該当行をアンコメントして Apache を再起動する
# (モジュール本体 /Applications/MAMP/Library/modules/mod_deflate.so は同梱済み)。
# 無効なままだと IfModule ごと無視されるだけで、動作には影響しない。
# 公開時 (Cloudflare Tunnel / ngrok) は同じ資産がエッジ側でも圧縮される。
<IfModule deflate_module>
    # 実測: HTML+CSS+JS の合計 395KB -> 111KB、api.php の radar_map 8.5KB -> 1.8KB
    # (AddOutputFilterByType は mod_filter が必要で、無効時に 500 になるため使わない)
    SetOutputFilter DEFLATE
</IfModule>
<IfModule setenvif_module>
    # 既に圧縮済みの形式は二重圧縮しない (Varyヘッダも付けない)。
    # mod_deflate は no-gzip 環境変数を見て圧縮を止める。
    # (SetEnvIfNoCase は setenvif_module の機能なので deflate のガード内には置かない)
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|woff2?|ttf|otf|mp4|webm|zip|gz)$ no-gzip dont-vary
</IfModule>

# ブラウザ資産は Vite がファイル名に内容のハッシュを入れる (assets/index-<hash>.js)。
# 中身が変わればURLも変わるので、assets/ は長く持たせてよい (再検証の往復を無くす)。
# 以前は index.html が ?v=<ハッシュ> を付けて frontend/*.js を参照していたが、
# その方式はビルド成果物のハッシュに置き換わった (?v= が残るのは OGPカード画像だけ)。
# 画面の HTML は毎回検証し、常に最新の資産を参照できるようにする。
# mod_rewrite が無効な環境では IfModule ごと無視され、全資産が短めキャッシュになるだけ。
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^assets/ - [E=tunedrop_immutable:1]
</IfModule>
<IfModule headers_module>
    # OGPカード画像 (SNS/検索結果のプレビュー用) やアイコンは更新が稀なので長めに持たせる。
    <FilesMatch "\.(?:png|jpe?g|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # 検索エンジンのクローラーが定期的に読む。長すぎるキャッシュは避ける (1時間)。
    <FilesMatch "^(?:robots\.txt|sitemap\.xml)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    <FilesMatch "\.(?:css|js|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    # assets/ (Viteのハッシュ付き資産) は URL が内容に紐づくので長く持たせる。
    # Header は後から書いたものが上書きするため、必ずこの最後に置くこと
    # (上に置くと、下の png/svg の 7日ルールに負ける)。
    <FilesMatch "\.(?:js|css|svg|png|jpe?g|webp|gif|ico|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable" env=tunedrop_immutable
    </FilesMatch>
</IfModule>
