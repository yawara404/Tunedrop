<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tune drop: 検索エンジンに登録してよい公開ページの一覧

  正規URLは https://music.wawa-app.me/tunedrop/。
  ホスト直下 / と大文字 /Tunedrop/ は router.php が 301 で /tunedrop/ へ移動するため、
  サイトマップには正規URLだけを載せる。

  載せていない URL と理由:
  - 画面 (Manager / Radar / Share / Help など) は History API のパス
    (/radar, /share など) で、canonical をトップに集約しているため1枚として扱う。
  - 公開プレイリストの共有URL (ogp.php?playlist=N) は ogp.php が meta noindex で返す
    (カード表示専用で、すぐ SPA へ転送するため)。noindex の URL を sitemap へ載せると
    Search Console で「noindex により除外」としてノイズになるため載せない。

  lastmod は ./sync.sh が「ビルド成果物 (index.html / assets/) を更新した日」に書き換える。
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://music.wawa-app.me/tunedrop/</loc>
    <lastmod>2026-11-25</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
