# Copy to .env and chmod 600 .env. Values are literal KEY=value pairs (no shell execution or expansion).
# Process environment variables take precedence over this file.
# GOOGLE_CLIENT_ID must match frontend/config.js.
GOOGLE_CLIENT_ID=
YOUTUBE_API_KEY=
GEMINI_API_KEY=
PORT=5001
# SQLite のロック待ち上限（秒）。MAMP(PHP) と同時に書き込むため短めにする。
# TUNEDROP_DB_TIMEOUT=5
# 音源解析エンジン: auto(既定) / librosa(CLAPを使わない) / none(音源解析なし)
# TUNEDROP_VIBE_ENGINE=auto
# CLAP のソフトマックス温度。小さいほど1つのラベルへ尖る（既定 0.07 / none で温度なし）。
# TUNEDROP_CLAP_TEMPERATURE=0.07
# CLAP の「テンポ感」(slow/mid/upbeat/fast) を BPM 判定へ効かせる重み（既定 0.35 / 0 で無効）。
# TUNEDROP_CLAP_TEMPO_WEIGHT=0.35
# CLAP の重み読み込み失敗時の再試行回数（既定 2）。
# TUNEDROP_CLAP_RETRY=2
# CLAP の重みを別の場所に置く場合の絶対パス（未設定は laion-clap 同梱の重みを使う）。
# TUNEDROP_CLAP_CKPT=/absolute/path/630k-audioset-best.pt
# JWT uses the shared .jwt_secret file by default.

# ---- AI解析 (Gemini が使えないときのローカルLLMフォールバック) ----
# Gemini は課金クレジット切れで 402 を返すことがある。その場合は Ollama を使う。
# TUNEDROP_AI_ENGINE=auto          # auto (gemini→ollama→rules) / gemini / ollama / rules
# OLLAMA_MODEL=qwen3:8b            # `ollama list` にあるモデル (12B等の大型は使わない)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_TIMEOUT=120
# TUNEDROP_OLLAMA_THINK=0          # 思考モデル(qwen3)の思考無効化。1 で有効化

# ---- 負荷対策 (重い解析でマシンを占有しない) ----
# TUNEDROP_CPU_THREADS=4        # 音源解析(librosa/CLAP/torch)のスレッド上限。既定はコア数の半分。"all" で無制限
# TUNEDROP_ANALYZE_THROTTLE=0.5 # 解析バッチの1曲ごとの待ち(秒)
# TUNEDROP_MAP_CACHE_TTL=60     # /radar/map 応答のキャッシュ秒数 (UIが何度も呼ぶため)
